{
  // Cloudflare Workers static-assets config: publishes the Next.js static export (`npm run build` → out/).
  // Having this file stops Wrangler from auto-detecting Next.js and trying a server-side (OpenNext) build.
  "$schema": "node_modules/wrangler/config-schema.json",
  // must match the project name in the Cloudflare dashboard
  "name": "aaryasutar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
